{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!apps/mobile/.expo",
      "!apps/mobile/android",
      "!apps/mobile/ios",
      "!apps/mobile/expo-env.d.ts",
      "!apps/mobile/src/uniwind-types.d.ts",
      "!**/routeTree.gen.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    },
    "jsxRuntime": "transparent"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}